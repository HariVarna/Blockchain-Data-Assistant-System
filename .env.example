# Ethereum Sepolia RPC URL
# Options:
# - Public Node: https://ethereum-sepolia-rpc.publicnode.com
# - Public RPC: https://rpc.sepolia.org
# - Infura: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# - Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Explorer / Indexer API Configuration
# Blockscout Sepolia provides free public indexer API with no mandatory key:
# https://eth-sepolia.blockscout.com/api
# Or use Etherscan Sepolia: https://api-sepolia.etherscan.io/api
VITE_EXPLORER_API_URL=https://eth-sepolia.blockscout.com/api

# Optional Etherscan API key (Blockscout works without key; Etherscan Sepolia requires one for higher rate limits)
VITE_ETHERSCAN_API_KEY=your_optional_api_key_here
